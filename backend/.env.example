# ─── Server ───────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Supabase ─────────────────────────────────
# Get these from your Supabase project dashboard
# Settings → API → Project URL, anon key, service_role key
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=yoyur-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── JWT (used by NestJS to sign access tokens)
# Generate a secure random key:
#   openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRATION=7d

# ─── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins
# Dev: http://localhost:3000
# Prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# ─── Puppeteer ────────────────────────────────
# Path to Chromium executable (set automatically on Render)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ─── Upload ───────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
